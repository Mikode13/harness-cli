{
	"name": "@mikode13/harness-cli",
	"version": "0.0.0-development",
	"description": "Command-line consumer for @mikode13/harness",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mikode13/harness-cli.git"
	},
	"bin": {
		"harness-cli": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"packageManager": "pnpm@11.17.0",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "mikode-git-hooks install",
		"prepack": "pnpm run build",
		"build": "mikode-scripts clean dist && tsc -p tsconfig.build.json",
		"start": "node dist/cli.js",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests",
		"test": "pnpm run test:unit && pnpm run test:integration",
		"test:unit": "vitest run --project unit",
		"test:unit:watch": "vitest --project unit",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --project unit --project integration --coverage",
		"pack:check": "pnpm run build && node scripts/pack-check.mjs",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
	},
	"dependencies": {
		"@mikode13/harness": "1.0.0"
	},
	"devDependencies": {
		"@mikode13/code-quality": "1.0.0",
		"@mikode13/code-style": "1.0.0",
		"@mikode13/cross-platform": "1.0.0",
		"@mikode13/git-hooks": "1.0.0",
		"@mikode13/tsconfig": "1.0.0",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.8.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
